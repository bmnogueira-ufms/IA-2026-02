# --- Material de sala ---
# Os slides das aulas teóricas ficam fora do versionamento (PDFs grandes); eles
# são distribuídos pelo Moodle. O curinga cobre as duas formas de acentuação que
# o macOS pode gravar no nome da pasta.
Aulas Te*ricas/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Ambientes virtuais ---
.venv/
venv/
env/
ENV/

# --- Editores e IDEs ---
.vscode/
.idea/
.claude/
*.swp

# --- Sistema operacional ---
.DS_Store
Thumbs.db
desktop.ini

# --- Docker ---
# variáveis locais (PORTA, HOST_UID, HOST_GID) — o Makefile já cuida disso
.env

# --- Saídas temporárias ---
*.log
/tmp/
